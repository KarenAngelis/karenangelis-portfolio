{
    # Atrás do Caddy da VPS, confia no IP informado por proxies de rede privada (usado para limitar abuso nas estatísticas).
    servers {
        trusted_proxies static private_ranges
    }
}
{$PORTFOLIO_DOMAIN} {
    encode zstd gzip
    @legacyResume path /demos/kotlin /demos/kotlin/
    redir @legacyResume /app/?version=kotlin 302
    header /downloads/*.apk Content-Type application/vnd.android.package-archive
    header /downloads/*.apk Content-Disposition "attachment; filename=karenangelis-curriculo.apk"
    @trends path /api/trends /api/news /docs /openapi.json
    handle @trends {
        reverse_proxy trends-api:8000
    }
    handle /api/stats/* {
        reverse_proxy stats-api:8001
    }
    handle /api/profile {
        reverse_proxy resume-api:8080
    }
    handle /api/career/* {
        reverse_proxy career-api:8010
    }
    header /carreira/* {
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
    handle {
        root * /srv
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
