PROSPECT_DB=/data/prospect.sqlite3
PROSPECT_ADMIN_TOKEN=
UNSUBSCRIBE_SECRET=
PUBLIC_BASE_URL=https://karenangelis.com
CASA_DADOS_API_KEY=
COLLECT_ENABLED=false
COLLECT_START_DATE=2026-10-27
COLLECT_PAGE_SIZE=100
LOOKBACK_DAYS=7
WORKER_INTERVAL_SECONDS=5
AUTO_QUEUE_VERIFIED=false
SEND_ENABLED=false
# Campaign ceiling; a new Google account may have a lower provider quota.
# Keep disabled until credentials, provider quota and deployment are verified.
SEND_DAILY_LIMIT=1500
SEND_INTERVAL_SECONDS=55
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@karenangelis.com
# Google app password, stored only on the server; never use the account password.
SMTP_PASSWORD=
SMTP_FROM=contato@karenangelis.com

# Fonte propria: importa arquivos oficiais RFB sem consultas pagas.
COLLECT_PROVIDER=rfb

RFB_SYNC_ENABLED=false
