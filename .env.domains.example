# Copy privately to .env.domains on the VPS. Never commit real credentials.
DOMAINS_ORIGIN=https://karenangelis.com
DOMAINS_DB=/data/domains.sqlite3
# Both false until provider sandbox acceptance and production configuration.
DOMAINS_SALES_ENABLED=false
DOMAINS_LIVE=false
RESELLERCLUB_ID=
RESELLERCLUB_API_KEY=
# Explicit approved selling prices in BRL cents; no made-up prices shipped to customers.
# Example format only: {"com":{"register":7500,"renew":8500}}
DOMAIN_PRICES_JSON={}
# Use nameservers actually provisioned by the DNS hosting provider, not placeholders.
DOMAIN_NAMESERVERS=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
# Web OAuth client; authorized JavaScript origin must match DOMAINS_ORIGIN.
GOOGLE_CLIENT_ID=
# STARTTLS SMTP, used only for account verification and password recovery.
DOMAIN_SMTP_HOST=
DOMAIN_SMTP_PORT=587
DOMAIN_SMTP_USER=
DOMAIN_SMTP_PASSWORD=
DOMAIN_MAIL_FROM=
# Preparation only: Payouts is not wired to checkout or the order worker.
# Keep disabled until the registrar's automatic credit attribution is verified.
DOMAINS_PAYOUTS_MODE=disabled
MERCADOPAGO_PAYOUTS_ACCESS_TOKEN=
MERCADOPAGO_PAYOUTS_ACCOUNT_ID=
DOMAIN_FUNDING_PIX_TYPE=
DOMAIN_FUNDING_PIX_KEY=
DOMAIN_FUNDING_MAX_CENTS=0
DOMAIN_FUNDING_RECIPIENT_VERIFIED=false
DOMAINS_PAYOUTS_LIVE_AUTHORIZED=false
MERCADOPAGO_PAYOUTS_SIGNING_KEY_FILE=
